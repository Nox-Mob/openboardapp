# OpenBoardApp environment variables. Copy to `.env.local` (untracked) and fill in.
# Anything starting with VITE_ is built into the browser bundle and is PUBLIC.
# The hosted edition gets its public values from wrangler.jsonc instead.
# Never commit real values (docs/SHARED-SPEC.md §7).

# --- Public: your Supabase project (publishable key only) ---
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
# Same values for server-side rendering
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>

# --- Public: suite settings (SHARED-SPEC §1.1, §7.1) ---
# false (default) = self-hosted: Board keeps its own sign-in, organizations and invitations.
# true = OpenAppHub hosted build: those live in the hub.
VITE_HOSTED=false
VITE_APP_ID=board
VITE_APP_SCHEMA=board
# Hosted only: hub address, shared cookie domain, other apps (JSON of app -> URL)
VITE_HUB_URL=
VITE_COOKIE_DOMAIN=
VITE_SUITE_URLS=
# Help links; defaults to https://docs.openapphub.org
VITE_DOCS_URL=

# Board needs no secrets: it never uses a service-role key.

# --- Tests only ---
# SKIP_DB_TESTS=1 skips the tests that need a running database.
